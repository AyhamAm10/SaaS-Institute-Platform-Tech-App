{
  "expo": {
    "name": "جيل السلام للمعلمين",
    "slug": "tech-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/logo-mark.png",
    "scheme": "techapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141416",
        "foregroundImage": "./assets/brand/logo-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "me.ayhamashram.jil.teacher",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/logo-mark.png",
      "name": "جيل السلام للمعلمين",
      "shortName": "المعلمين"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141416",
          "image": "./assets/brand/logo-mark.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F16726",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
